# SocraCode Server Configuration
SOCRA_HOST=127.0.0.1
SOCRA_PORT=8000
SOCRA_ENV=development
SOCRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sandbox Runner Settings
RUNNER_TYPE=local
RUNNER_TIMEOUT_SECONDS=5.0
RUNNER_MAX_OUTPUT_BYTES=65536

# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
